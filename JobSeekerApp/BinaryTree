package ds_le;

public class BinaryTree<T extends Comparable<T>> {  // Add the Comparable constraint here
    private BST_Node<T> root;

    public BinaryTree() {
        root = null;
    }

    // Insert a new node into the Binary Tree (not ordered)
    public void insert(T data) {
        root = insertRecursive(root, data);
    }

    private BST_Node<T> insertRecursive(BST_Node<T> node, T data) {
        if (node == null) {
            return new BST_Node<>(data);
        }

        // Insert data in the left subtree if possible, otherwise in the right
        if (node.getLeftTree() == null) {
            node.setLeftTree(new BST_Node<>(data));
        } else if (node.getRightTree() == null) {
            node.setRightTree(new BST_Node<>(data));
        } else {
            // If both left and right are occupied, insert into the left or right depending on your logic
            node.setLeftTree(insertRecursive(node.getLeftTree(), data));
        }

        return node;
    }

    // Pre-order traversal of the tree
    public void preOrder() {
        preOrderRecursive(root);
    }

    private void preOrderRecursive(BST_Node<T> node) {
        if (node != null) {
            System.out.println(node.getData());
            preOrderRecursive(node.getLeftTree());
            preOrderRecursive(node.getRightTree());
        }
    }

    // Post-order traversal of the tree
    public void postOrder() {
        postOrderRecursive(root);
    }

    private void postOrderRecursive(BST_Node<T> node) {
        if (node != null) {
            postOrderRecursive(node.getLeftTree());
            postOrderRecursive(node.getRightTree());
            System.out.println(node.getData());
        }
    }

    // In-order traversal of the tree
    public void inOrder() {
        inOrderRecursive(root);
    }

    private void inOrderRecursive(BST_Node<T> node) {
        if (node != null) {
            inOrderRecursive(node.getLeftTree());
            System.out.println(node.getData());
            inOrderRecursive(node.getRightTree());
        }
    }
}
