public class BinaryTree {
    
    BST_Node<JobSeeker> root;

    public void InOrder(BST_Node t){       
        if (t != null)  {
            InOrder(t.getLeftTree());
            System.out.println(t.getData().getName() + " - Priority: " + t.getData().calculatePriority());
            InOrder(t.getRightTree());
        }
    }
    
    public void PostOrder(BST_Node t) {
        if (t != null)
        {
            PostOrder(t.getLeftTree());
            PostOrder(t.getRightTree());
            System.out.print(t.getData().getName() + " - Priority: " + t.getData().calculatePriority());
        }
    }
     
    public void PreOrder(BST_Node t) {
        if (t != null)
        {
            System.out.print(t.getData().getName() + " - Priority: " + t.getData().calculatePriority());
            PreOrder(t.getLeftTree());
            PreOrder(t.getRightTree());
        }
     }
       
    public void InOrder_toChar(BST_Node t) {        
        if (t != null)  {
            InOrder_toChar(t.getLeftTree());
             System.out.print((char)t.getData());
            InOrder_toChar(t.getRightTree());
        }
    }
    
    public void PostOrder_toChar(BST_Node t) {
        if (t != null) {
            PostOrder_toChar(t.getLeftTree());
            PostOrder_toChar(t.getRightTree());
            System.out.print((char)t.getData());
        }
    }
     
    public void PreOrder_toChar(BST_Node t) {
        if (t != null) {
        System.out.print((char)t.getData());
        PreOrder_toChar(t.getLeftTree());
           PreOrder_toChar(t.getRightTree());
       }
    }
     
    public int getHeight(BST_Node bt) {
       if(bt == null)
           return -1;
       else
           return 1 + Math.max(getHeight(bt.getLeftTree()),getHeight(bt.getRightTree()));
    }
    
    public BST_Node<JobSeeker> getRoot(){
        return root;       
    }
    
    public void setRoot(BST_Node<JobSeeker> r){
       root = r;
    }

}
