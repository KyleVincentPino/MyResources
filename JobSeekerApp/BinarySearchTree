package ds_le;

public class BST<T extends Comparable<T>> {
    private BST_Node<T> root;

    public BST() {
        root = null;
    }

    // Insert a new node into the BST
    public void insert(T data) {
        root = insertRecursive(root, data);
    }

    private BST_Node<T> insertRecursive(BST_Node<T> node, T data) {
        if (node == null) {
            return new BST_Node<>(data);
        }

        if (data.compareTo(node.getData()) < 0) {
            node.setLeftTree(insertRecursive(node.getLeftTree(), data));
        } else if (data.compareTo(node.getData()) > 0) {
            node.setRightTree(insertRecursive(node.getRightTree(), data));
        }

        return node;
    }

    // Search for a node by value
    public boolean search(T data) {
        return searchRecursive(root, data);
    }

    private boolean searchRecursive(BST_Node<T> node, T data) {
        if (node == null) {
            return false;
        }

        if (data.compareTo(node.getData()) == 0) {
            return true;
        }

        return data.compareTo(node.getData()) < 0
                ? searchRecursive(node.getLeftTree(), data)
                : searchRecursive(node.getRightTree(), data);
    }

    // Delete a node from the BST
    public void delete(T data) {
        root = deleteRecursive(root, data);
    }

    private BST_Node<T> deleteRecursive(BST_Node<T> node, T data) {
        if (node == null) {
            return null;
        }

        if (data.compareTo(node.getData()) < 0) {
            node.setLeftTree(deleteRecursive(node.getLeftTree(), data));
        } else if (data.compareTo(node.getData()) > 0) {
            node.setRightTree(deleteRecursive(node.getRightTree(), data));
        } else {
            // Node to be deleted found
            if (node.getLeftTree() == null) {
                return node.getRightTree();
            } else if (node.getRightTree() == null) {
                return node.getLeftTree();
            }

            // Node with two children
            node.setData(minValue(node.getRightTree()));
            node.setRightTree(deleteRecursive(node.getRightTree(), node.getData()));
        }

        return node;
    }

    private T minValue(BST_Node<T> node) {
        T minValue = node.getData();
        while (node.getLeftTree() != null) {
            minValue = node.getLeftTree().getData();
            node = node.getLeftTree();
        }
        return minValue;
    }

    // In-order traversal of the tree
    public void inOrder() {
        inOrderRecursive(root);
    }

    private void inOrderRecursive(BST_Node<T> node) {
        if (node != null) {
            inOrderRecursive(node.getLeftTree());
            System.out.println(node.getData());
            inOrderRecursive(node.getRightTree());
        }
    }
}
