import java.util.LinkedList;

public class DS_EmployeeQueue_LinkedList {
   
   // Queue (LinkedList) Implementation
   
   private LinkedList<Employee> employeeList;

   public DS_EmployeeQueue_LinkedList() {
      employeeList = new LinkedList<>(); // Initialize the LinkedList
   }

   public boolean checkDuplicateID(int ID) {
      for (Employee employee : employeeList) {
         if (employee.getID() == ID) {
            return false; // ID already exists
         }
      }
      return true; // ID is unique
   }

   public void enqueue(Employee employee) {
      if (checkDuplicateID(employee.getID())) { // Ensure ID is unique before adding
         employeeList.add(employee); // Adds to the end of the list
      } else {
         System.out.println("Duplicate ID! Employee not added.");
      }
   }

   public void remove() {
      if (!employeeList.isEmpty()) {
         employeeList.removeLast(); // Remove last employee
      } else {
         System.out.println("List is empty, nothing to remove.");
      }
   }

   public void removeByIndex(int index) {
      if (index >= 0 && index < employeeList.size()) {
         employeeList.remove(index); // Remove employee at specific index
      } else {
         System.out.println("Index out of bounds.");
      }
   }

   public Employee getItem(int index) {
      if (index >= 0 && index < employeeList.size()) {
         return employeeList.get(index); // Return employee at specific index
      }
      return null; // Return null if index is out of bounds
   }

   public int getSize() {
      return employeeList.size(); // Return the size of the list
   }

   public LinkedList<Employee> getList() {
      return employeeList; // Return the LinkedList
   }

   public int searchByName(String name) {
      for (int i = 0; i < employeeList.size(); i++) {
         if (employeeList.get(i).getName().equals(name)) {
            return i; // Return index if name matches
         }
      }
      return -1; // Return -1 if not found
   }

   public int searchByID(int id) {
      for (int i = 0; i < employeeList.size(); i++) {
         if (employeeList.get(i).getID() == id) {
            return i; // Return index if ID matches
         }
      }
      return -1; // Return -1 if not found
   }

   @Override
   public String toString() {
      StringBuilder str = new StringBuilder();
      for (Employee employee : employeeList) {
         str.append(employee.toString()).append("\n\n");
      }
      return str.toString(); // Return all employees as a string
   }
}
